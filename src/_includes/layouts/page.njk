---
layout: base.njk
---

<div class="container mx-auto px-6 py-8 md:py-12">
  {% if featuredImage %}
    <div class="mb-8">
      <img src="{{ featuredImage }}" alt="{{ title }}" class="w-full h-64 md:h-96 object-cover rounded-lg shadow-md">
    </div>
  {% endif %}
  
  <h1 class="text-4xl md:text-5xl font-bold text-primary mb-8">{{ title }}</h1>

  <div class="prose prose-lg max-w-none prose-headings:text-primary">
    {{ content | safe }}
  </div>
</div> 