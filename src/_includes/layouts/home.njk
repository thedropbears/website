---
layout: base.njk
---

<!-- Hero Section -->
<section class="relative">
  <div class="bg-primary">
    <div class="container mx-auto px-6 py-12 md:py-24">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8 items-center">
        <div class="text-white text-left">
          <h1 class="text-4xl md:text-5xl font-bold mb-4 text-left">The Drop Bears</h1>
          <p class="text-xl mb-6">FRC Team 4774 - Sydney, Australia</p>
          <p class="mb-8">We're a FIRST Robotics Competition team inspiring students in STEM through competitive robotics.</p>

          {# Toggle settings.interestForm.open to switch the hero between recruiting and the default join path #}
          {% if settings.interestForm.open %}
            {% set primaryCta = { text: "Express your interest", url: "/eoi/" } %}
            {% set secondaryCta = { text: "How joining works", url: "/join/" } %}
          {% else %}
            {% set primaryCta = { text: "Join the team", url: "/join/" } %}
            {% set secondaryCta = { text: "About the team", url: "/info/" } %}
          {% endif %}

          <div class="flex flex-wrap gap-4">
            <a href="{{ primaryCta.url }}" class="inline-block px-6 py-3 bg-accent text-primary font-semibold rounded-lg hover:bg-yellow-500 transition focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white">
              {{ primaryCta.text }}
            </a>
            <a href="{{ secondaryCta.url }}" class="inline-block px-6 py-3 text-white font-medium rounded-lg ring-2 ring-inset ring-white hover:bg-white hover:text-primary transition focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white">
              {{ secondaryCta.text }}
            </a>
          </div>
        </div>
        <div>
          <img src="/static/img/hero-robot.jpg" alt="The Drop Bears Robot" class="rounded-lg shadow-lg">
        </div>
      </div>
    </div>
  </div>
</section>

<!-- What is FRC Section -->
<section class="py-12 md:py-16 bg-gray-50">
  <div class="container mx-auto px-6 text-center">
    <h2 class="text-3xl font-bold text-primary mb-4">What is FRC?</h2>
    <p class="text-gray-600 max-w-3xl mx-auto mb-8">FIRST Robotics Competition is a global, annual challenge where teams design, build, and program a robot every January. FRC combines the energy of sport with hands-on STEM.</p>
    <div class="flex flex-wrap justify-center items-center gap-x-6 gap-y-4">
      <a href="/what-is-frc/" class="inline-block px-6 py-3 bg-primary text-white font-medium rounded-lg hover:bg-blue-800 transition">
        Learn more about FRC
      </a>
      <a href="https://youtu.be/VUXFyxdBxkE?si=c26lCBjw_WBBk7k6" class="text-primary font-medium underline underline-offset-4 hover:text-blue-800">
        Watch a game
      </a>
    </div>
  </div>
</section>

<!-- What We Do Section -->
<section class="py-12 md:py-24">
  <div class="container mx-auto px-6">
    <h2 class="text-3xl font-bold text-primary text-center mb-12">What We Do</h2>
    
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      <div class="bg-white rounded-lg shadow-md p-6 border-t-4 border-primary">
        <i class="ph ph-shield w-12 h-12 text-primary mb-4"></i>
        <h3 class="text-xl font-bold mb-2">Build Robots</h3>
        <p>We design, build, and program competitive robots for the FIRST Robotics Competition, learning real-world engineering skills.</p>
      </div>
      
      <div class="bg-white rounded-lg shadow-md p-6 border-t-4 border-accent">
        <i class="ph ph-info w-12 h-12 text-accent mb-4"></i>
        <h3 class="text-xl font-bold mb-2">Compete Globally</h3>
        <p>We participate in regional and international competitions, representing Australia on the world stage of STEM education.</p>
      </div>
      
      <div class="bg-white rounded-lg shadow-md p-6 border-t-4 border-primary">
        <i class="ph ph-keyboard w-12 h-12 text-primary mb-4"></i>
        <h3 class="text-xl font-bold mb-2">Inspire Others</h3>
        <p>We engage with our community through outreach programs, mentoring, and promoting STEM education to inspire the next generation.</p>
      </div>
    </div>
  </div>
</section>

<!-- Team Calendar -->
<section class="py-12 md:py-24">
  <div class="container mx-auto px-6">
    <h2 class="text-3xl font-bold text-primary text-center mb-8">Our Calendar</h2>
    <p class="text-center text-gray-600 max-w-3xl mx-auto mb-12">Stay up to date with team meetings, build sessions, competitions, and outreach events.</p>
    
    <div class="bg-white rounded-lg shadow-lg overflow-hidden">
      <div class="responsive-iframe">
        <iframe src="https://calendar.google.com/calendar/embed?src=thedropbears.org.au_3b909umhsnqlm1teubd6iv6s3g%40group.calendar.google.com&ctz=Australia%2FSydney" style="border: 0" width="800" height="600" frameborder="0" scrolling="no"></iframe>
          <p class="p-8 text-center text-gray-600">
            <strong>Calendar Temporarily Unavailable</strong><br>
            Our team calendar is currently being updated. Please check back soon or 
            <a href="mailto:enquiries@thedropbears.org.au" class="text-primary hover:text-accent">contact us</a> 
            for upcoming events and meeting times.
          </p>
        </iframe>
      </div>
    </div>

    <!-- Location Map -->
    <div class="mt-8">
      <h3 class="text-xl font-bold text-primary text-center mb-4">Our Location</h3>
      <p class="text-center text-gray-600 mb-6">Rose Street Building, University of Sydney</p>
      
      <div class="bg-white rounded-lg shadow-lg overflow-hidden">
        <div class="map-container">
          <iframe 
            src="https://www.google.com/maps/embed?pb=!1m14!1m8!1m3!1d3311.9970040478825!2d151.193705!3d-33.889731!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x6b12b1d6b0d7f649%3A0xc7f7ee572544cdb5!2sRose%20Street%20Building%2C%20Darlington%20NSW%202008%2C%20Australia!5e0!3m2!1sen!2sus!4v1753780750939!5m2!1sen!2sus" 
            width="100%" 
            height="300" 
            style="border:0;" 
            allowfullscreen="" 
            loading="lazy" 
            referrerpolicy="no-referrer-when-downgrade"
            title="The Drop Bears Location - Rose Street Building, University of Sydney">
          </iframe>
        </div>
      </div>
    </div>
  </div>
</section>

<section class="py-12 bg-gray-50">
  <div class="container mx-auto px-6">
    <div class="flex justify-between items-center mb-6">
      <h2 class="text-3xl font-bold text-primary">Latest Video</h2>
      <a href="https://www.youtube.com/@thedropbears" class="text-primary hover:text-accent">Visit Channel</a>
    </div>

    <div class="bg-white rounded-lg shadow-lg overflow-hidden">
      <div class="responsive-iframe">
        <iframe
          src="https://www.youtube.com/embed/videoseries?list=UUp9bo9X9uXZOaNanhKPNSZw"
          title="The Drop Bears – Latest Uploads"
          width="100%"
          height="400"
          frameborder="0"
          loading="lazy"
          allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
          allowfullscreen>
        </iframe>
      </div>
    </div>
  </div>
 </section>

<style>
  .responsive-iframe {
    position: relative;
    padding-bottom: 56.25%; /* 16:9 Aspect Ratio */
    height: 0;
    overflow: hidden;
  }
  .responsive-iframe iframe {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }
</style>
