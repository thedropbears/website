---
layout: base.njk
---

<div class="container mx-auto px-6 py-8 md:py-12">
  {% if featuredImage %}
  <div class="relative mb-8 overflow-hidden rounded-lg shadow-md">
    <!-- Blurred backdrop -->
    <img src="{{ featuredImage }}" alt="" aria-hidden="true"
         class="absolute inset-0 w-full h-full object-cover blur-2xl scale-110">
    <div class="absolute inset-0 bg-white/20"></div>
    <img src="{{ featuredImage }}" alt="{{ title }}"
         class="relative mx-auto h-auto max-w-4xl w-full">
  </div>
  {% endif %}
  
  <h1 class="text-3xl md:text-4xl font-bold text-primary mb-4">{{ title }}</h1>
  
  <div class="prose prose-lg max-w-none">
    {{ content | safe }}
  </div>
</div> 